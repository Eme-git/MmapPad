* text=auto

# »сходный код и конфиги Ч LF
*.cs          text eol=lf diff=csharp
*.csproj      text eol=lf
*.props       text eol=lf
*.targets     text eol=lf
*.json        text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.md          text eol=lf
*.editorconfig text eol=lf

# Solution и файлы дизайнера Ч CRLF (совместимость с VS)
*.sln         text eol=crlf merge=union
*.Designer.cs text eol=crlf
*.resx        text eol=crlf